# HCM Lite — environment variable NAMES (never commit real values).
# Copy to .env.local and fill in locally. .env.local is git-ignored.

# Supabase (required — dashboard: Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini (Phase 8 AI assistant) — SERVER ONLY, never NEXT_PUBLIC_*
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Set to "true" ONLY after you have read and accepted Google's Gemini API
# data-use terms FOR YOUR TIER (free tier may use data for training — do not
# send HR data on it): https://ai.google.dev/gemini-api/terms
# While false/unset, the assistant answers policy questions only and never
# sends HR data to the provider.
AI_ALLOW_HR_CONTEXT=false
